#!/usr/bin/env bash

set -eu -o pipefail

user_name="$( id --user --name )"

for command in fuse-overlayfs newgidmap newuidmap podman slirp4netns; do
    command -v "${command}" >/dev/null || {
        echo "error: '${command}' is required for rootless Podman" >&2
        exit 1
    }
done

[[ "$( stat --file-system --format=%T /sys/fs/cgroup )" == cgroup2fs ]] || {
    echo "error: rootless Podman Quadlets require cgroup v2" >&2
    exit 1
}

grep --quiet "^${user_name}:" /etc/subuid || {
    echo "error: no subordinate UID range configured for ${user_name}" >&2
    exit 1
}
grep --quiet "^${user_name}:" /etc/subgid || {
    echo "error: no subordinate GID range configured for ${user_name}" >&2
    exit 1
}

[[ "$( podman info --format '{{.Host.CgroupsVersion}}' )" == v2 ]] || {
    echo "error: Podman did not report cgroup v2" >&2
    exit 1
}

[[ "$( podman info --format '{{.Host.Security.Rootless}}' )" == true ]] || {
    echo "error: Podman did not report rootless mode" >&2
    exit 1
}

[[ "$( podman info --format '{{.Store.GraphDriverName}}' )" == overlay ]] || {
    echo "error: Podman did not report the overlay storage driver" >&2
    exit 1
}

[[ "$( podman info --format '{{.Host.NetworkBackend}}' )" == netavark ]] || {
    echo "error: Podman did not report the netavark network backend" >&2
    exit 1
}

quadlet_directory="${XDG_CONFIG_HOME:-${HOME}/.config}/containers/systemd"
[[ -d "${quadlet_directory}" ]] || {
    echo "error: rootless Quadlet directory is missing: ${quadlet_directory}" >&2
    exit 1
}

podman unshare true

echo "rootless Podman prerequisites verified"
