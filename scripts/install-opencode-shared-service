#!/usr/bin/env bash
#
# Install the OpenCode shared-service wrapper and its user unit.
#
# The wrapper is a host-runtime script, so it is installed outside the
# repository: the unit must not depend on a checkout that moves or
# changes under it. The repository keeps the source and this installer
# keeps the deployed copy in sync.

set -eu -o pipefail

repo_root="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"

wrapper_source="${repo_root}/scripts/opencode-shared-service"
wrapper_target="${HOME}/.local/bin/opencode-shared-service"
unit_source="${repo_root}/configuration/systemd/user/opencode-shared.service"
unit_target="${config_home}/systemd/user/opencode-shared.service"

mkdir --parents "$( dirname "${wrapper_target}" )" "$( dirname "${unit_target}" )"

install --mode=0755 "${wrapper_source}" "${wrapper_target}"
install --mode=0644 "${unit_source}" "${unit_target}"

if command -v systemctl >/dev/null; then
    if ! systemctl --user daemon-reload; then
        echo "warning: unable to run 'systemctl --user daemon-reload'" >&2
        echo "warning: run it manually in a user session before starting the unit" >&2
    fi
fi

echo "installed ${wrapper_target}"
echo "installed ${unit_target}"
echo "start it with: systemctl --user start opencode-shared.service"
