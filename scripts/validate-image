#!/usr/bin/env bash

set -eu -o pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="opencode"

for arg in "$@"; do
    case "${arg}" in
        base|opencode|codex|muse|opencode-pandoc|opencode-litrpg) target="${arg}" ;;
        *)
            echo "error: unknown argument ${arg}" >&2
            exit 1
            ;;
    esac
done

image_tag="cistella/${target}:local"

# shellcheck disable=SC1090,SC1091
. "${repository_root}/images/cistella/base/pins.sh"
if [[ "${target}" != "base" ]]; then
    # shellcheck disable=SC1090,SC1091
    . "${repository_root}/images/cistella/${target}/pins.sh"
fi

if ! podman image exists "${image_tag}"; then
    echo "error: image ${image_tag} does not exist" >&2
    exit 1
fi

podman run --rm --userns=keep-id --env TERM=xterm-ghostty "${image_tag}" \
    sh -c 'infocmp xterm-ghostty >/dev/null && test "$(tput colors)" = "256"'

podman run --rm --userns=keep-id --env HOME=/ --env TERM=xterm-ghostty "${image_tag}" \
    sh -c '
        test "$(command -v agentmux)" = "/usr/local/bin/agentmux"
        test "$(command -v agentsmgr)" = "/usr/local/bin/agentsmgr"
        test "$(command -v copier)" = "/usr/local/bin/copier"
        test "$(command -v hatch)" = "/usr/local/bin/hatch"
        test "$(command -v openspec)" = "/usr/local/bin/openspec"
        test "$(command -v nbspec)" = "/usr/local/bin/nbspec"
        test "$(command -v nb-mcp)" = "/usr/local/bin/nb-mcp"
        test "$(command -v nb)" = "/usr/local/bin/nb"
        test "$(command -v column)" = "/usr/bin/column"
        test "$(command -v curl)" = "/usr/bin/curl"
        test "$(command -v file)" = "/usr/bin/file"
        test "$(command -v gdb)" = "/usr/bin/gdb"
        test "$(command -v gh)" = "/usr/local/bin/gh"
        test "$(command -v git)" = "/usr/bin/git"
        test "$(command -v git-lfs)" = "/usr/bin/git-lfs"
        test "$(command -v ss)" = "/usr/bin/ss"
        test "$(command -v jq)" = "/usr/bin/jq"
        test "$(command -v linecheck)" = "/usr/local/bin/linecheck"
        test "$(command -v lsof)" = "/usr/bin/lsof"
        test "$(command -v ltrace)" = "/usr/bin/ltrace"
        test "$(command -v nano)" = "/usr/bin/nano"
        test "$(command -v nc)" = "/usr/bin/nc"
        test "$(command -v ps)" = "/usr/bin/ps"
        test "$(command -v pip3)" = "/usr/bin/pip3"
        test "$(command -v pre-commit)" = "/usr/local/bin/pre-commit"
        test "$(command -v python)" = "/usr/bin/python"
        test "$(command -v python3)" = "/usr/bin/python3"
        test "$(command -v rg)" = "/usr/bin/rg"
        test "$(command -v rsync)" = "/usr/bin/rsync"
        test "$(command -v shellcheck)" = "/usr/bin/shellcheck"
        test "$(command -v shfmt)" = "/usr/bin/shfmt"
        test "$(command -v socat)" = "/usr/bin/socat"
        test "$(command -v ssh-keygen)" = "/usr/bin/ssh-keygen"
        test "$(command -v strace)" = "/usr/bin/strace"
        test "$(command -v uv)" = "/usr/local/bin/uv"
        test "$(command -v vibelinter)" = "/usr/local/bin/vibelinter"
        test "$(command -v tmux)" = "/usr/local/bin/tmux"
        test "$(command -v tree)" = "/usr/bin/tree"
        test "$(command -v unzip)" = "/usr/bin/unzip"
        test "$(command -v xxd)" = "/usr/bin/xxd"
        test "$(command -v yq)" = "/usr/bin/yq"
        test "$(command -v zstd)" = "/usr/bin/zstd"
        test -x /usr/bin/cc
    '

podman run --rm --userns=keep-id "${image_tag}" cc --version >/dev/null
podman run --rm --userns=keep-id "${image_tag}" \
    sh -c 'test -f /etc/profile.d/seat-path.sh'
podman run --rm --userns=keep-id "${image_tag}" \
    sh -c 'mkdir -p /tmp/seatprobe/.cargo/bin /tmp/seatprobe/.local/bin && printf "#!/bin/sh\necho probe-ok\n" > /tmp/seatprobe/.local/bin/probe-tool && chmod +x /tmp/seatprobe/.local/bin/probe-tool && env -i HOME=/tmp/seatprobe /bin/bash -lc "command -v probe-tool"'
# Anchor on the family field: bare "DejaVu Sans" also matches Mono lines.
podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
    sh -c 'fc-list | grep --quiet ": DejaVu Sans:" && fc-list | grep --quiet ": DejaVu Sans Mono:"'
podman run --rm --userns=keep-id "${image_tag}" tmux -V | grep --quiet "${TMUX_VERSION}"
podman run --rm --userns=keep-id "${image_tag}" gh --version | grep --quiet "${GH_VERSION}"

case "${target}" in
    base)
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test -z "$(command -v opencode || true)" && test -z "$(command -v codex || true)" && test -z "$(command -v muse || true)"'
        ;;
    opencode)
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v opencode)" = "/usr/local/bin/opencode"'
        podman run --rm --userns=keep-id --env HOME=/tmp --env TERM=xterm-ghostty "${image_tag}" \
            sh -c "opencode --version | grep --quiet '${OPENCODE_VERSION}'"
        ;;
    codex)
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v codex)" = "/usr/local/bin/codex"'
        podman run --rm --userns=keep-id --env HOME=/tmp --env TERM=xterm-ghostty "${image_tag}" \
            sh -c "codex --version 2>&1 | grep --quiet '${CODEX_VERSION}'"
        ;;
    muse)
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v muse)" = "/usr/local/bin/muse"'
        podman run --rm --userns=keep-id --env HOME=/tmp --env TERM=xterm-ghostty "${image_tag}" \
            sh -c "muse --version 2>&1 | grep --quiet '${MUSE_VERSION}'"
        ;;
    opencode-pandoc)
        # Lane pins carry the lane's own duplicated OPENCODE_* plus PANDOC_*
        # (D3); base pins were sourced at the top for every target.
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v opencode)" = "/usr/local/bin/opencode"'
        podman run --rm --userns=keep-id --env HOME=/tmp --env TERM=xterm-ghostty "${image_tag}" \
            sh -c "opencode --version | grep --quiet '${OPENCODE_VERSION}'"
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v pandoc)" = "/usr/local/bin/pandoc"'
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            sh -c "pandoc --version | head -1 | grep --quiet 'pandoc ${PANDOC_VERSION}'"
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            sh -c 'xelatex --version >/dev/null && pdftotext -v 2>&1 | grep --quiet "poppler"'
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" sh -c '
            cd /tmp \
            && printf "# Handbook check\n\n## Details subsection\n\nA table, an em-dash — and an arrow →.\n\n| alpha | beta |\n|---|---|\n| gamma | delta |\n" > handbook-check.md \
            && pandoc handbook-check.md -o handbook-check.pdf --toc --toc-depth=2 --pdf-engine=xelatex \
            && test -s handbook-check.pdf \
            && test -z "$(pdffonts handbook-check.pdf | tail -n +3 | grep -v "yes *yes *yes" || true)" \
            && pdftotext handbook-check.pdf - | grep --quiet "—" \
            && pdftotext handbook-check.pdf - | grep --quiet "→" \
            && test "$(pdftotext handbook-check.pdf - | grep -o "Details subsection" | wc -l)" -ge 2 \
            && pdftotext handbook-check.pdf - | grep --quiet gamma'
        ;;
    opencode-litrpg)
        # Union composition proves every claimed capability: harness,
        # documents render, browser-runtime libraries, comfy tools.
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v opencode)" = "/usr/local/bin/opencode"'
        podman run --rm --userns=keep-id --env HOME=/tmp --env TERM=xterm-ghostty "${image_tag}" \
            sh -c "opencode --version | grep --quiet '${OPENCODE_VERSION}'"
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v pandoc)" = "/usr/local/bin/pandoc"'
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            sh -c "pandoc --version | head -1 | grep --quiet 'pandoc ${PANDOC_VERSION}'"
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            sh -c 'xelatex --version >/dev/null && pdftotext -v 2>&1 | grep --quiet "poppler"'
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" sh -c '
            cd /tmp \
            && printf "# Handbook check\n\n## Details subsection\n\nA table, an em-dash — and an arrow →.\n\n| alpha | beta |\n|---|---|\n| gamma | delta |\n" > handbook-check.md \
            && pandoc handbook-check.md -o handbook-check.pdf --toc --toc-depth=2 --pdf-engine=xelatex \
            && test -s handbook-check.pdf \
            && test -z "$(pdffonts handbook-check.pdf | tail -n +3 | grep -v "yes *yes *yes" || true)" \
            && pdftotext handbook-check.pdf - | grep --quiet "—" \
            && pdftotext handbook-check.pdf - | grep --quiet "→" \
            && test "$(pdftotext handbook-check.pdf - | grep -o "Details subsection" | wc -l)" -ge 2 \
            && pdftotext handbook-check.pdf - | grep --quiet gamma'
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'for p in libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcups2t64 libdbus-1-3 libgbm1 libpango-1.0-0 libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2; do dpkg -l "$p" 2>/dev/null | tail -1 | grep --quiet "^ii" || exit 1; done'
        # Bounded browser-runtime capability proof: every claimed library
        # must actually load (plus a negative control proving the check
        # is not vacuous). This is load proof, not a browser launch: no
        # browser binary ships in the image, so no launch is attempted
        # and no sandbox, device, network, or display exemption exists.
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            python3 -c "import ctypes; [ctypes.CDLL(l) for l in ['libasound.so.2','libatk-bridge-2.0.so.0','libatk-1.0.so.0','libatspi.so.0','libcups.so.2','libdbus-1.so.3','libgbm.so.1','libpango-1.0.so.0','libXcomposite.so.1','libXdamage.so.1','libXfixes.so.3','libxkbcommon.so.0','libXrandr.so.2']]; print('browser-runtime-load-ok')"
        podman run --rm --userns=keep-id --env HOME=/tmp "${image_tag}" \
            sh -c 'python3 -c "import ctypes; ctypes.CDLL(\"libnope-not-real.so.0\")" 2>/dev/null && exit 1 || exit 0'
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'test "$(command -v comfy-mcp)" = "/usr/local/bin/comfy-mcp" && test "$(command -v comfy)" = "/usr/local/bin/comfy"'
        podman run --rm --userns=keep-id --env HOME=/ "${image_tag}" \
            sh -c 'for t in shellcheck shfmt ss nc socat rsync unzip zstd gdb strace ltrace tree; do command -v "$t" >/dev/null || exit 1; done'
        ;;
esac

echo "${image_tag} ok"
