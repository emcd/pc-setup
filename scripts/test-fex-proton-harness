ln -s "${home8}/Games/FEX+Proton/real-target" "${home8}/Games/FEX+Proton/fex-proton"
if HOME="${home8}" FAKE_UNAME_M=aarch64 run_setup "${home8}" harness >/dev/null 2>&1; then
    report fail "launcher-symlink-refused" "exit 0, expected refusal"
else
    if [[ "$(cat "${home8}/Games/FEX+Proton/real-target")" == "target content" ]]; then
        report ok "launcher-symlink-refused"
    else
        report fail "launcher-symlink-refused" "symlink target altered"
    fi
fi

# --- 28. missing FEX creates no state --------------------------------------------------------------------------
if HOME="${home1}" FAKE_UNAME_M=aarch64 FEX_BIN=/nonexistent FEX_ROOTFS="${home1}/snap/steam/common/x86_rootfs" \
    "${h1}/fex-proton" g_nostate /tmp/game/GH.exe >/dev/null 2>&1; then
    report fail "missing-fex-no-state" "exit 0, expected refusal"
else
    code=$?
    if [[ $code -eq 2 && ! -e "${h1}/prefixes/g_nostate" ]]; then
        report ok "missing-fex-no-state"
    else
        report fail "missing-fex-no-state" "exit ${code} or state created"
    fi
fi

# --- 29. unrunnable FEXBash refuses -----------------------------------------------------------------------------
cat > "${fakebin}/FEXBash-dead" <<'EOF'
#!/usr/bin/env bash
echo "fake dead emulator" >&2
exit 127
EOF
chmod +x "${fakebin}/FEXBash-dead"
if HOME="${home1}" FAKE_UNAME_M=aarch64 FEX_BIN="${fakebin}/FEXBash-dead" \
    FEX_ROOTFS="${home1}/snap/steam/common/x86_rootfs" \
    "${h1}/fex-proton" g_dead /tmp/game/GH.exe >/dev/null 2>&1; then
    report fail "dead-emulator-refused" "exit 0, expected refusal"
else
    code=$?
    if [[ $code -eq 2 && ! -e "${h1}/prefixes/g_dead" ]]; then
        report ok "dead-emulator-refused"
    else
        report fail "dead-emulator-refused" "exit ${code} or state created"
    fi
fi

# --- 30. missing RootFS python refuses ----------------------------------------------------------------------------
if HOME="${home1}" FAKE_UNAME_M=aarch64 FEX_BIN="${fakebin}/FEXBash" \
    FEX_ROOTFS="${suite_root}/empty-rootfs" \
    "${h1}/fex-proton" g_nopython /tmp/game/GH.exe >/dev/null 2>&1; then
