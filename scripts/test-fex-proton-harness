    fi
fi

# --- 31b. nonexecutable RootFS interpreter refuses ---------------------------------------------
home9b="${suite_root}/home9b"
new_home "${home9b}"
rm "${home9b}/snap/steam/common/x86_rootfs/usr/bin/python3"
printf '#!/bin/sh\nexit 0\n' > "${home9b}/snap/steam/common/x86_rootfs/usr/bin/python3"
chmod 644 "${home9b}/snap/steam/common/x86_rootfs/usr/bin/python3"
export FAKE_UNAME_M=aarch64
if HOME="${home9b}" FEX_BIN="${fakebin}/FEXBash" FEX_ROOTFS="${home9b}/snap/steam/common/x86_rootfs" \
    "${h1}/fex-proton" g_nonexec /tmp/game/GH.exe >/dev/null 2>&1; then
    report fail "nonexec-interpreter-refused" "exit 0, expected refusal"
else
    code=$?
    if [[ $code -eq 2 && ! -e "${h1}/prefixes/g_nonexec" ]]; then
        report ok "nonexec-interpreter-refused"
    else
        report fail "nonexec-interpreter-refused" "exit ${code} or state created"
    fi
fi

# --- 31. symlinked prefixes dir refuses ------------------------------------------------------------------------------
home9="${suite_root}/home9"
new_home "${home9}"
export FAKE_UNAME_M=aarch64
run_setup "${home9}" harness >/dev/null 2>&1
h9="$(harness_of "${home9}")"
rmdir "${h9}/prefixes" "${h9}/logs" 2>/dev/null || true
mkdir -p "${suite_root}/redirect-target"
ln -s "${suite_root}/redirect-target" "${h9}/prefixes"
if HOME="${home9}" FAKE_UNAME_M=aarch64 FEX_BIN="${fakebin}/FEXBash" \
    FEX_ROOTFS="${home1}/snap/steam/common/x86_rootfs" \
    "${h9}/fex-proton" g_esc /tmp/game/GH.exe >/dev/null 2>&1; then
    report fail "prefix-symlink-refused" "exit 0, expected refusal"
else
    if [[ ! -e "${suite_root}/redirect-target/g_esc" && ! -e "${suite_root}/redirect-target/pfx" ]]; then
        report ok "prefix-symlink-refused"
    else
        report fail "prefix-symlink-refused" "wrote through symlinked tree"
    fi
fi

# --- 32. space-containing HOME works -----------------------------------------------------------------------
# Quoting across the harness must survive spaces. One fresh deploy
# plus one migration refusal proves the common paths, not every case.
spacehome="${suite_root}/home with space"
new_home "${spacehome}"
export FAKE_UNAME_M=aarch64
unset FAKE_MV_FAIL_STAGE FAKE_MV_FAIL_REPLACE FAKE_CP_FAIL FAKE_CP_CORRUPT FAKE_PGREP_HOLD FAKE_PGREP_MATCH FAKE_MUTATE_DIR
if HOME="${spacehome}" run_setup "${spacehome}" harness >/dev/null 2>&1; then
    sps="$(harness_of "${spacehome}")"
    if [[ -x "${sps}/fex-proton" && -d "${sps}/proton" && -f "${sps}/proton-manifest" ]] \
        && grep -q "^PROVENANCE=snap-copy$" "${sps}/proton-manifest"; then
        report ok "space-path-deploy"
    else
        report fail "space-path-deploy" "layout or manifest wrong"
    fi
else
    report fail "space-path-deploy" "harness exited $?"
fi

echo "---"
echo "pass=${pass} fail=${fail}"
[[ "${fail}" == "0" ]]
