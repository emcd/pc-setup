#!/usr/bin/env bash
#
# Failure-path tests for scripts/refresh-images.
#
# Uses a fixture repo copy (PC_SETUP_ROOT) plus stub curl/podman on PATH,
# so no test mutates real pins, images, or the real lock. Each case asserts
# exit codes from the documented contract (0 clean / 1 drift / 2 error)
# and byte-level pin/tag state.
#
# Usage: test-refresh-images   (exit 0 all pass, 1 any failure)

set -eu -o pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
suite_root="$(mktemp -d)"
trap 'rm -rf "${suite_root}"' EXIT

pass=0
fail=0

report() {
    local result="$1" name="$2"
    if [[ "${result}" == "ok" ]]; then
        pass=$((pass + 1))
        echo "PASS ${name}"
    else
        fail=$((fail + 1))
        echo "FAIL ${name}: $3"
    fi
}

# --- fixture repo -----------------------------------------------------------
skeleton="${suite_root}/skeleton"
mkdir -p "${skeleton}/scripts" "${skeleton}/images/cistella/base" \
    "${skeleton}/images/cistella/opencode" "${skeleton}/images/cistella/codex"
cp "${repo_root}/scripts/refresh-images" "${repo_root}/scripts/build-image" \
    "${repo_root}/scripts/validate-image" "${skeleton}/scripts/"
cp "${repo_root}/images/cistella/base/pins.sh" "${skeleton}/images/cistella/base/"
cp "${repo_root}/images/cistella/opencode/pins.sh" "${skeleton}/images/cistella/opencode/"
cp "${repo_root}/images/cistella/codex/pins.sh" "${skeleton}/images/cistella/codex/"

# --- stubs ------------------------------------------------------------------
stubbin="${suite_root}/stubbin"
mkdir -p "${stubbin}"

# Stub curl: scenario via $CURL_MODE. Routes on URL substring.
cat > "${stubbin}/curl" <<'STUB'
#!/usr/bin/env bash
# args of interest: --output FILE, --dump-header FILE, URL (last http arg)
out=""; dump=""; url=""
prev=""
for a in "$@"; do
    case "${prev}" in
        --output) out="${a}" ;;
        --dump-header) dump="${a}" ;;
    esac
    case "${a}" in
        http*) url="${a}" ;;
    esac
    prev="${a}"
done
mode="${CURL_MODE:-ok}"
fail_exit() { exit "${1:-22}"; }
repo_digest() {
    case "${url}" in
        */library/rust/*) printf '%s' "${STUB_RUST_DIGEST:-sha256:abc}" ;;
        *) printf '%s' "${STUB_DEBIAN_DIGEST:-sha256:abc}" ;;
    esac
}
case "${mode}" in
    http-fail) fail_exit 22 ;;
    late-codex-fail)
        case "${url}" in
            *openai/codex*) fail_exit 22 ;;
        esac
        ;;
    registry-fail)
        case "${url}" in
            *auth.docker.io*) fail_exit 28 ;;
        esac
        ;;
esac
case "${url}" in
    *api.github.com/repos/anomalyco/opencode*)
        [[ "${mode}" == "malformed" ]] && { echo "not json"; exit 0; }
        echo "{\"tag_name\": \"${STUB_OC_TAG:-v1.19.0}\"}"
        ;;
    *api.github.com/repos/openai/codex*)
        [[ "${mode}" == "malformed" ]] && { echo "not json"; exit 0; }
        [[ "${mode}" == "empty-codex" ]] && { echo "[]"; exit 0; }
        python3 -c '
import os
tags = os.environ.get("STUB_CODEX_TAGS", "rust-v0.162.1").split()
import json
print(json.dumps([{"tag_name": t, "prerelease": False, "draft": False,
                   "published_at": "2026-10-%02dT00:00:00Z" % (10 + i)}
                  for i, t in enumerate(tags)]))'
        ;;
    *auth.docker.io/token*)
        echo '{"token": "stub-token"}'
        ;;
    *registry-1.docker.io/v2/*)
        if [[ -n "${dump}" ]]; then
            printf 'docker-content-digest: %s\r\n' "$(repo_digest)" > "${dump}"
            printf 'content-type: application/vnd.oci.image.index.v1+json\r\n' >> "${dump}"
        fi
        ;;
    *pypi.org/pypi/*)
        [[ "${mode}" == "pypi-fail" ]] && fail_exit 22
        dist="$(printf '%s' "${url}" | sed -E 's#.*/pypi/([^/]+)/json#\1#')"
        key="$(printf '%s' "${dist}" | tr 'a-z-' 'A-Z_')"
        eval "info=\"\${STUB_PYPI_INFO_${key}:-}\""
        eval "extras=\"\${STUB_PYPI_EXTRA_${key}:-}\""
        eval "yanked=\"\${STUB_PYPI_YANKED_${key}:-}\""
        STUB_PYPI_INFO_VAL="${info}" STUB_PYPI_EXTRA_VAL="${extras}" \
        STUB_PYPI_YANKED_VAL="${yanked}" python3 -c '
import json, os
info = os.environ["STUB_PYPI_INFO_VAL"]
rels = {info: [{}]}
for v in os.environ["STUB_PYPI_EXTRA_VAL"].split():
    rels[v] = [{}]
for v in os.environ["STUB_PYPI_YANKED_VAL"].split():
    rels[v] = [{"yanked": True}]
print(json.dumps({"info": {"version": info}, "releases": rels}))'
        ;;
    *crates.io/api/v1/crates/*)
        [[ "${mode}" == "crate-fail" ]] && fail_exit 22
        name="${url##*/}"
        key="$(printf '%s' "${name}" | tr 'a-z-' 'A-Z_')"
        eval "current=\"\${STUB_CRATE_${key}:-}\""
        eval "new=\"\${STUB_CRATE_NEW_${key}:-}\""
        eval "yanked=\"\${STUB_CRATE_YANKED_${key}:-}\""
        eval "pre=\"\${STUB_CRATE_PRE_${key}:-}\""
        STUB_CRATE_CURRENT="${current}" STUB_CRATE_NEW="${new}" \
        STUB_CRATE_YANKED_VAL="${yanked}" STUB_CRATE_PRE_VAL="${pre}" python3 -c '
import json, os
vs = []
if os.environ["STUB_CRATE_CURRENT"]:
    vs.append({"num": os.environ["STUB_CRATE_CURRENT"], "yanked": False})
if os.environ["STUB_CRATE_NEW"]:
    vs.append({"num": os.environ["STUB_CRATE_NEW"], "yanked": False})
for v in os.environ["STUB_CRATE_PRE_VAL"].split():
    vs.append({"num": v, "yanked": False})
for v in os.environ["STUB_CRATE_YANKED_VAL"].split():
    vs.append({"num": v, "yanked": True})
print(json.dumps({"crate": {"id": "x"}, "versions": vs}))'
        ;;
    *releases/download*)
        [[ -n "${out}" ]] || fail_exit 26
        printf 'fake-tarball-bytes-for-%s' "${url##*/}" > "${out}"
        ;;
    *) fail_exit 22 ;;
esac
STUB
chmod +x "${stubbin}/curl"

# Stub podman: state dir via $PODMAN_STATE. Tags are references to image
# IDs (ids: TAG=ID); per-image labels live in imglabels (ID=label). This
# models real `podman tag` (new name, same image) versus `build` (new
# image). `pull` is forbidden: refresh must not pull.
cat > "${stubbin}/podman" <<'STUB'
#!/usr/bin/env bash
st="${PODMAN_STATE:?}"
cmd="$1"; shift
tag_id() { grep -E "^$1=" "${st}/ids" 2>/dev/null | cut -d= -f2-; }
case "${cmd}" in
    pull) echo "stub: pull forbidden" >&2; exit 3 ;;
    image)
        sub="$1"; shift
        case "${sub}" in
            exists) [[ -n "$(tag_id "$1")" ]] ;;
            inspect)
                fmt=""; tag=""
                prev=""
                for a in "$@"; do
                    [[ "${prev}" == "--format" ]] && fmt="${a}"
                    prev="${a}"
                done
                tag="${*: -1}"
                case "${fmt}" in
                    *Labels*)
                        id="$(tag_id "${tag}")"
                        [[ -n "${id}" ]] || exit 1
                        grep -E "^${id}=" "${st}/imglabels" 2>/dev/null | cut -d= -f2-
                        ;;
                    *) echo "" ;;
                esac
                ;;
        esac
        ;;
    tag)
        src="$1"; dst="$2"
        id="$(tag_id "${src}")"
        [[ -n "${id}" ]] || exit 1
        grep -vE "^${dst}=" "${st}/ids" 2>/dev/null > "${st}/ids.tmp" || true
        mv "${st}/ids.tmp" "${st}/ids"
        echo "${dst}=${id}" >> "${st}/ids"
        echo "${src} -> ${dst} (${id})" >> "${st}/taglog"
        ;;
    build)
        tag=""; label=""
        prev=""
        for a in "$@"; do
            [[ "${prev}" == "--tag" ]] && tag="${a}"
            [[ "${a}" == pc-setup.refresh-pins=* ]] && label="${a#pc-setup.refresh-pins=}"
            prev="${a}"
        done
        echo "build ${tag} label=${label}" >> "${st}/buildlog"
        n="$(cat "${st}/buildcount")"; n=$((n + 1)); echo "${n}" > "${st}/buildcount"
        if [[ -n "$(cat "${st}/fail_build_n" 2>/dev/null || true)" ]] \
            && [[ "${n}" == "$(cat "${st}/fail_build_n")" ]]; then
            exit 1
        fi
        c="$(cat "${st}/idcounter")"; c=$((c + 1)); echo "${c}" > "${st}/idcounter"
        id="img${c}"
        grep -vE "^${tag}=" "${st}/ids" 2>/dev/null > "${st}/ids.tmp" || true
        mv "${st}/ids.tmp" "${st}/ids"
        echo "${tag}=${id}" >> "${st}/ids"
        echo "${id}=${label}" >> "${st}/imglabels"
        ;;
    run)
        echo "run $*" >> "${st}/runlog"
        if [[ -e "${st}/fail_run" ]]; then
            exit 1
        fi
        printf 'tmux %s\ngh version %s\nopencode %s\ncodex %s\n' \
            "${STUB_TMUX_V:-3.4}" "${STUB_GH_V:-2.101.0}" \
            "${STUB_OC_V:-1.19.0}" "${STUB_CODEX_V:-0.162.1}"
        exit 0
        ;;
    *) echo "stub: unknown podman ${cmd}" >&2; exit 3 ;;
esac
STUB
chmod +x "${stubbin}/podman"

# --- case setup ---------------------------------------------------------------
# new_case <name>: fresh fixture root + state; prints fixture path.
new_case() {
    local case_root="${suite_root}/case-$1"
    rm -rf "${case_root}"
    cp -r "${skeleton}" "${case_root}"
    mkdir -p "${case_root}/state"
    : > "${case_root}/state/ids"
    : > "${case_root}/state/imglabels"
    : > "${case_root}/state/buildlog"
    : > "${case_root}/state/taglog"
    : > "${case_root}/state/runlog"
    echo 0 > "${case_root}/state/buildcount"
    echo 0 > "${case_root}/state/idcounter"
    printf '%s' "${case_root}"
}

seed_images() {
    # $1 fixture root; :local tags present with labels matching live pins.
    local root="$1" name h id
    for name in base opencode codex; do
        id="img-${name}-0"
        echo "cistella/${name}:local=${id}" >> "${root}/state/ids"
    done
    h="$(sha256sum "${root}/images/cistella/base/pins.sh" | cut -d' ' -f1)"
    echo "img-base-0=${h}" >> "${root}/state/imglabels"
    for name in opencode codex; do
        h="$(cat "${root}/images/cistella/base/pins.sh" \
            "${root}/images/cistella/$name/pins.sh" | sha256sum | cut -d' ' -f1)"
        echo "img-${name}-0=${h}" >> "${root}/state/imglabels"
    done
}

local_id() {
    # $1 fixture root, $2 tag -> image id (empty if absent).
    grep -E "^$2=" "$1/state/ids" 2>/dev/null | cut -d= -f2-
}

run_refresh() {
    # $1 fixture root; rest = refresh-images args. Prints exit code.
    local root="$1"; shift
    ( cd "${root}" &&
        PATH="${stubbin}:${PATH}" \
        PC_SETUP_ROOT="${root}" \
        XDG_RUNTIME_DIR="${root}" \
        CURL_MODE="${CURL_MODE:-ok}" \
        PODMAN_STATE="${root}/state" \
        STUB_OC_TAG="${STUB_OC_TAG:-}" \
        STUB_CODEX_TAGS="${STUB_CODEX_TAGS:-}" \
        STUB_DEBIAN_DIGEST="${STUB_DEBIAN_DIGEST:-}" \
        STUB_RUST_DIGEST="${STUB_RUST_DIGEST:-}" \
        STUB_TMUX_V="${STUB_TMUX_V:-}" \
        STUB_GH_V="${STUB_GH_V:-}" \
        STUB_OC_V="${STUB_OC_V:-}" \
        STUB_CODEX_V="${STUB_CODEX_V:-}" \
        ./scripts/refresh-images "$@" >"${root}/stdout" 2>"${root}/stderr"; echo "$?" )
}

pins_sha() {
    sha256sum "$1/images/cistella/base/pins.sh" \
        "$1/images/cistella/opencode/pins.sh" \
        "$1/images/cistella/codex/pins.sh" | sha256sum | cut -d' ' -f1
}

current_versions_env() {
    # Export stub versions matching fixture pins so validate greps pass.
    local root="$1"
    # shellcheck disable=SC1091
    STUB_TMUX_V="$( ( . "${root}/images/cistella/base/pins.sh" && printf '%s' "${TMUX_VERSION}" ) )"
    STUB_GH_V="$( ( . "${root}/images/cistella/base/pins.sh" && printf '%s' "${GH_VERSION}" ) )"
    STUB_OC_V="$( ( . "${root}/images/cistella/opencode/pins.sh" && printf '%s' "${OPENCODE_VERSION}" ) )"
    STUB_CODEX_V="$( ( . "${root}/images/cistella/codex/pins.sh" && printf '%s' "${CODEX_VERSION}" ) )"
    export STUB_TMUX_V STUB_GH_V STUB_OC_V STUB_CODEX_V
    STUB_OC_TAG="v${STUB_OC_V}"
    STUB_CODEX_TAGS="rust-v${STUB_CODEX_V}"
    STUB_DEBIAN_DIGEST="$( ( . "${root}/images/cistella/base/pins.sh" && printf '%s' "${DEBIAN_IMAGE}" ) | sed -E 's/.*@//')"
    STUB_RUST_DIGEST="$( ( . "${root}/images/cistella/base/pins.sh" && printf '%s' "${RUST_IMAGE}" ) | sed -E 's/.*@//')"
    export STUB_OC_TAG STUB_CODEX_TAGS STUB_DEBIAN_DIGEST STUB_RUST_DIGEST
    local pair dist var key val
    for pair in "emcd-agents:EMCD_AGENTS_VERSION" "hatch:HATCH_VERSION" "pre-commit:PRE_COMMIT_VERSION" "copier:COPIER_VERSION" "agentmux:AGENTMUX_VERSION" "nbspec:NBSPEC_VERSION" "nb-mcp-server:NB_MCP_VERSION" "linecheck:LINECHECK_VERSION"; do
        dist="${pair%%:*}"; var="${pair##*:}"
        key="$(printf '%s' "${dist}" | tr 'a-z-' 'A-Z_')"
        # shellcheck disable=SC1091
        val="$( ( . "${root}/images/cistella/base/pins.sh" && printf '%s' "${!var}" ) )"
        case "${dist}" in
            emcd-agents|hatch|pre-commit|copier)
                printf -v "STUB_PYPI_INFO_${key}" '%s' "${val}"
                export "STUB_PYPI_INFO_${key}"
                ;;
            *)
                printf -v "STUB_CRATE_${key}" '%s' "${val}"
                export "STUB_CRATE_${key}"
                ;;
        esac
    done
    STUB_PYPI_EXTRA_EMCD_AGENTS=""; export STUB_PYPI_EXTRA_EMCD_AGENTS
    STUB_PYPI_YANKED_EMCD_AGENTS=""; export STUB_PYPI_YANKED_EMCD_AGENTS
    STUB_CRATE_NEW_AGENTMUX=""; export STUB_CRATE_NEW_AGENTMUX
    STUB_CRATE_YANKED_AGENTMUX=""; export STUB_CRATE_YANKED_AGENTMUX
    STUB_CRATE_NEW_LINECHECK=""; export STUB_CRATE_NEW_LINECHECK
    STUB_CRATE_PRE_LINECHECK=""; export STUB_CRATE_PRE_LINECHECK
}

# --- cases --------------------------------------------------------------------

# 1. check clean -> 0
r="$(new_case clean)"
seed_images "${r}"
current_versions_env "${r}"
code="$(run_refresh "${r}" check)"
[[ "${code}" == "0" ]] && report ok "check-clean" || report fail "check-clean" "exit=${code}"

# 2. check drift -> 1, pins untouched
r="$(new_case drift)"
seed_images "${r}"
current_versions_env "${r}"
before="$(pins_sha "${r}")"
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after="$(pins_sha "${r}")"
if [[ "${code}" == "1" && "${before}" == "${after}" ]]; then
    report ok "check-drift"
else
    report fail "check-drift" "exit=${code} pins_changed=$([[ "${before}" != "${after}" ]] && echo yes || echo no)"
fi

# 3-6. operational failures -> 2 (curl fail, malformed, empty codex, registry)
for mode in http-fail malformed empty-codex registry-fail; do
    r="$(new_case "err-${mode}")"
    seed_images "${r}"
    current_versions_env "${r}"
    code="0"
    CURL_MODE="${mode}" \
        PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
        PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
        >"${r}/stdout" 2>"${r}/stderr" || code="$?"
    [[ "${code}" == "2" ]] && report ok "check-err-${mode}" \
        || report fail "check-err-${mode}" "exit=${code}"
done

# 7. late discovery failure in apply -> 2, pins byte-identical, tags unchanged
r="$(new_case late-fail)"
seed_images "${r}"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
before_tags="$(sort "${r}/state/ids" | sha256sum)"
code="0"
CURL_MODE="late-codex-fail" STUB_OC_TAG="v9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_pins="$(pins_sha "${r}")"
after_tags="$(sort "${r}/state/ids" | sha256sum)"
if [[ "${code}" == "2" && "${before_pins}" == "${after_pins}" && "${before_tags}" == "${after_tags}" ]]; then
    report ok "apply-late-discovery-fail"
else
    report fail "apply-late-discovery-fail" "exit=${code}"
fi

# 8. late build failure -> 2, exact pre-run :local IDs + pin bytes restored.
#    Drift on both harnesses; harness builds reuse base without retagging
#    it, so build 1 = opencode (succeeds, retags), build 2 = codex (fails).
r="$(new_case build-fail)"
seed_images "${r}"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
before_base_id="$(local_id "${r}" 'cistella/base:local')"
before_oc_id="$(local_id "${r}" 'cistella/opencode:local')"
before_codex_id="$(local_id "${r}" 'cistella/codex:local')"
echo 2 > "${r}/state/fail_build_n"
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" STUB_CODEX_TAGS="rust-v9.99.0" \
    STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="9.99.0" STUB_CODEX_V="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_pins="$(pins_sha "${r}")"
: > "${r}/state/fail_build_n"
if [[ "${code}" == "2" && "${before_pins}" == "${after_pins}" \
    && "$(local_id "${r}" 'cistella/base:local')" == "${before_base_id}" \
    && "$(local_id "${r}" 'cistella/opencode:local')" == "${before_oc_id}" \
    && "$(local_id "${r}" 'cistella/codex:local')" == "${before_codex_id}" \
    && "$(local_id "${r}" 'cistella/opencode:previous')" == "${before_oc_id}" \
    && -z "$(local_id "${r}" 'cistella/base:previous')" ]]; then
    report ok "apply-late-build-fail-restores-ids"
else
    report fail "apply-late-build-fail-restores-ids" "exit=${code}"
fi

# 8b. validation failure after successful retags -> 2, IDs + pins restored.
touch "${r}/state/fail_run"
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" STUB_CODEX_TAGS="rust-v9.99.0" \
    STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="9.99.0" STUB_CODEX_V="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
rm -f "${r}/state/fail_run"
after_pins="$(pins_sha "${r}")"
if [[ "${code}" == "2" && "${before_pins}" == "${after_pins}" \
    && "$(local_id "${r}" 'cistella/base:local')" == "${before_base_id}" \
    && "$(local_id "${r}" 'cistella/opencode:local')" == "${before_oc_id}" \
    && "$(local_id "${r}" 'cistella/codex:local')" == "${before_codex_id}" ]]; then
    report ok "apply-validate-fail-restores-ids"
else
    report fail "apply-validate-fail-restores-ids" "exit=${code}"
fi

# 9. retry converges -> 0 with labels matching pins; second apply is a
#    no-build no-op.
: > "${r}/state/fail_build_n"
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" STUB_CODEX_TAGS="rust-v9.99.0" \
    STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="9.99.0" STUB_CODEX_V="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
ok_labels=1
for name in base opencode codex; do
    id="$(local_id "${r}" "cistella/${name}:local")"
    want=""
    case "${name}" in
        base) want="$(sha256sum "${r}/images/cistella/base/pins.sh" | cut -d' ' -f1)" ;;
        opencode) want="$(cat "${r}/images/cistella/base/pins.sh" "${r}/images/cistella/opencode/pins.sh" | sha256sum | cut -d' ' -f1)" ;;
        codex) want="$(cat "${r}/images/cistella/base/pins.sh" "${r}/images/cistella/codex/pins.sh" | sha256sum | cut -d' ' -f1)" ;;
    esac
    got="$(grep -E "^${id}=" "${r}/state/imglabels" | cut -d= -f2-)"
    [[ "${got}" == "${want}" ]] || ok_labels=0
done
builds_before="$(grep -c '^build ' "${r}/state/buildlog")"
code2="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" STUB_CODEX_TAGS="rust-v9.99.0" \
    STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="9.99.0" STUB_CODEX_V="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout2" 2>"${r}/stderr2" || code2="$?"
builds_after="$(grep -c '^build ' "${r}/state/buildlog")"
if [[ "${code}" == "0" && "${ok_labels}" == "1" && "${code2}" == "0" && "${builds_after}" == "${builds_before}" ]]; then
    report ok "apply-retry-converges-then-noop"
else
    report fail "apply-retry-converges-then-noop" "exit=${code}/${code2} builds=${builds_before}/${builds_after}"
fi

# 10. apply after rollback rebuilds (labels stale, pins already desired)
r="$(new_case apply-after-rollback)"
seed_images "${r}"
current_versions_env "${r}"
sed -i -E 's/^OPENCODE_VERSION=.*/OPENCODE_VERSION=9.99.0/' \
    "${r}/images/cistella/opencode/pins.sh"
: > "${r}/state/buildlog"
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="9.99.0" STUB_CODEX_V="0.156.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
if [[ "${code}" == "0" ]] && grep -q "build cistella/opencode:local" "${r}/state/buildlog" \
    && [[ "$(local_id "${r}" 'cistella/opencode:local')" != "img-opencode-0" ]]; then
    report ok "apply-after-rollback-rebuilds"
else
    report fail "apply-after-rollback-rebuilds" "exit=${code}"
fi

# 11. lock contention: mutator refused while lock held
r="$(new_case lock)"
seed_images "${r}"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
flock -x "${r}/pc-setup-refresh-images.lock" sleep 4 &
holder=$!
sleep 0.5
code="0"
CURL_MODE=ok STUB_OC_TAG="v9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
wait "${holder}"
after_pins="$(pins_sha "${r}")"
if [[ "${code}" == "2" && "${before_pins}" == "${after_pins}" ]] \
    && grep -q "refusing concurrent mutation" "${r}/stderr"; then
    report ok "lock-contention-refused"
else
    report fail "lock-contention-refused" "exit=${code}"
fi

# 12. rollback preflight: missing :previous -> no tags changed
r="$(new_case rollback-preflight)"
printf 'cistella/base:previous=img-base-old\ncistella/base:local=img-base-new\ncistella/opencode:local=img-oc-new\ncistella/codex:local=img-codex-new\n' > "${r}/state/ids"
printf 'img-base-old=h0\nimg-base-new=h1\nimg-oc-new=h2\nimg-codex-new=h3\n' > "${r}/state/imglabels"
before_tags="$(sort "${r}/state/ids" | sha256sum)"
code="0"
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --rollback \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_tags="$(sort "${r}/state/ids" | sha256sum)"
if [[ "${code}" == "2" && "${before_tags}" == "${after_tags}" ]]; then
    report ok "rollback-preflight-atomic"
else
    report fail "rollback-preflight-atomic" "exit=${code}"
fi

# 13. rollback single target restores exact image identity
r="$(new_case rollback-one)"
printf 'cistella/base:previous=img-base-old\ncistella/base:local=img-base-new\ncistella/opencode:local=img-oc-new\ncistella/codex:local=img-codex-new\n' > "${r}/state/ids"
printf 'img-base-old=h0\nimg-base-new=h1\nimg-oc-new=h2\nimg-codex-new=h3\n' > "${r}/state/imglabels"
code="0"
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --rollback base \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
if [[ "${code}" == "0" ]] \
    && [[ "$(local_id "${r}" 'cistella/base:local')" == "img-base-old" ]] \
    && [[ "$(local_id "${r}" 'cistella/opencode:local')" == "img-oc-new" ]]; then
    report ok "rollback-single-target-identity"
else
    report fail "rollback-single-target-identity" "exit=${code}"
fi

# 14. check with no upstream drift but missing labels -> 1, read-only:
#     zero build/tag/run calls, pins and image IDs unchanged.
r="$(new_case check-stale-missing)"
seed_images "${r}"
: > "${r}/state/imglabels"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
before_ids="$(sort "${r}/state/ids" | sha256sum)"
code="0"
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_pins="$(pins_sha "${r}")"
after_ids="$(sort "${r}/state/ids" | sha256sum)"
no_calls=0
[[ -s "${r}/state/buildlog" || -s "${r}/state/taglog" || -s "${r}/state/runlog" ]] || no_calls=1
if [[ "${code}" == "1" && "${before_pins}" == "${after_pins}" \
    && "${before_ids}" == "${after_ids}" && "${no_calls}" == "1" ]] \
    && grep -q "stale images" "${r}/stdout"; then
    report ok "check-stale-missing-readonly"
else
    report fail "check-stale-missing-readonly" "exit=${code}"
fi

# 15. check with mismatched labels -> same read-only guarantees.
r="$(new_case check-stale-wrong)"
seed_images "${r}"
printf 'img-base-0=wrong\nimg-opencode-0=wrong\nimg-codex-0=wrong\n' > "${r}/state/imglabels"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
before_ids="$(sort "${r}/state/ids" | sha256sum)"
code="0"
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_pins="$(pins_sha "${r}")"
after_ids="$(sort "${r}/state/ids" | sha256sum)"
no_calls=0
[[ -s "${r}/state/buildlog" || -s "${r}/state/taglog" || -s "${r}/state/runlog" ]] || no_calls=1
if [[ "${code}" == "1" && "${before_pins}" == "${after_pins}" \
    && "${before_ids}" == "${after_ids}" && "${no_calls}" == "1" ]]; then
    report ok "check-stale-wrong-readonly"
else
    report fail "check-stale-wrong-readonly" "exit=${code}"
fi

# 16. concurrent checks: both complete, neither mutates.
r="$(new_case check-concurrent)"
seed_images "${r}"
: > "${r}/state/imglabels"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
before_ids="$(sort "${r}/state/ids" | sha256sum)"
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout-a" 2>"${r}/stderr-a" &
pid_a=$!
PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout-b" 2>"${r}/stderr-b" &
pid_b=$!
code_a="0"; wait "${pid_a}" || code_a="$?"
code_b="0"; wait "${pid_b}" || code_b="$?"
after_pins="$(pins_sha "${r}")"
after_ids="$(sort "${r}/state/ids" | sha256sum)"
no_calls=0
[[ -s "${r}/state/buildlog" || -s "${r}/state/taglog" || -s "${r}/state/runlog" ]] || no_calls=1
if [[ "${code_a}" == "1" && "${code_b}" == "1" \
    && "${before_pins}" == "${after_pins}" \
    && "${before_ids}" == "${after_ids}" && "${no_calls}" == "1" ]]; then
    report ok "check-concurrent-readonly"
else
    report fail "check-concurrent-readonly" "exit=${code_a}/${code_b}"
fi

# 17. PyPI stable drift (hatch) -> check 1, apply bumps + rebuilds.
r="$(new_case pypi-drift)"
seed_images "${r}"
current_versions_env "${r}"
code="0"
CURL_MODE=ok STUB_PYPI_INFO_HATCH="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
code2="0"
CURL_MODE=ok STUB_PYPI_INFO_HATCH="9.99.0" STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="1.19.0" STUB_CODEX_V="0.156.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout2" 2>"${r}/stderr2" || code2="$?"
# shellcheck disable=SC1091
got_hatch="$( ( . "${r}/images/cistella/base/pins.sh" && printf '%s' "${HATCH_VERSION}" ) )"
if [[ "${code}" == "1" && "${code2}" == "0" && "${got_hatch}" == "9.99.0" ]] \
    && grep -q '^build ' "${r}/state/buildlog"; then
    report ok "pypi-stable-drift-applies"
else
    report fail "pypi-stable-drift-applies" "exit=${code}/${code2} hatch=${got_hatch}"
fi

# 18. held pre-commit drift -> check 0 with visible notice, pins frozen,
