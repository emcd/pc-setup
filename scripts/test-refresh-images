    || report fail "pypi-stable-allyanked-errors" "exit=${code}"

# 27. PyPI stable proves eligibility from releases, never trusts a
#     lying info.version: info claims prerelease 2.0a1, live 1.0 wins.
r="$(new_case pypi-stable-newerpre)"
sed -i -E 's/^HATCH_VERSION=.*/HATCH_VERSION=1.0/' \
    "${r}/images/cistella/base/pins.sh"
seed_images "${r}"
current_versions_env "${r}"
code="0"
CURL_MODE=ok STUB_PYPI_INFO_HATCH="2.0a1" STUB_PYPI_EXTRA_HATCH="1.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
[[ "${code}" == "0" ]] && report ok "pypi-stable-ignores-newer-pre" \
    || report fail "pypi-stable-ignores-newer-pre" "exit=${code}"

# 28. held drift stays visible on the apply path too (stdout2), pin
#     frozen, no rebuild.
r="$(new_case held-apply)"
seed_images "${r}"
current_versions_env "${r}"
before_pins="$(pins_sha "${r}")"
code="0"
CURL_MODE=ok STUB_PYPI_INFO_PRE_COMMIT="9.99.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
after_pins="$(pins_sha "${r}")"
no_builds=0
[[ -s "${r}/state/buildlog" ]] || no_builds=1
if [[ "${code}" == "0" && "${before_pins}" == "${after_pins}" \
    && "${no_builds}" == "1" ]] && grep -q "held" "${r}/stdout"; then
    report ok "held-visible-on-apply"
else
    report fail "held-visible-on-apply" "exit=${code}"
fi

# 29. mixed held + automatic drift: both visible, auto applied, held
#     frozen, rebuild caused by auto only.
r="$(new_case held-mixed)"
seed_images "${r}"
current_versions_env "${r}"
code="0"
CURL_MODE=ok STUB_PYPI_INFO_PRE_COMMIT="9.99.0" STUB_PYPI_INFO_HATCH="9.99.0" \
    STUB_TMUX_V="3.4" STUB_GH_V="2.101.0" \
    STUB_OC_V="1.19.0" STUB_CODEX_V="0.156.0" \
    PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
    PODMAN_STATE="${r}/state" ./scripts/refresh-images --apply \
    >"${r}/stdout" 2>"${r}/stderr" || code="$?"
# shellcheck disable=SC1091
got_pc="$( ( . "${r}/images/cistella/base/pins.sh" && printf '%s' "${PRE_COMMIT_VERSION}" ) )"
# shellcheck disable=SC1091
got_hatch="$( ( . "${r}/images/cistella/base/pins.sh" && printf '%s' "${HATCH_VERSION}" ) )"
if [[ "${code}" == "0" && "${got_pc}" != "9.99.0" && "${got_hatch}" == "9.99.0" ]] \
    && grep -q "held" "${r}/stdout" && grep -q "hatch" "${r}/stdout" \
    && grep -q '^build ' "${r}/state/buildlog"; then
    report ok "held-mixed-with-auto"
else
    report fail "held-mixed-with-auto" "exit=${code} pre-commit=${got_pc} hatch=${got_hatch}"
fi

echo "---- ${pass} passed, ${fail} failed ----"
[[ "${fail}" == "0" ]]
