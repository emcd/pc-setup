# 22-23. PyPI / crates.io transport failures -> 2.
for mode in pypi-fail crate-fail; do
    r="$(new_case "err-${mode}")"
    seed_images "${r}"
    current_versions_env "${r}"
    code="0"
    CURL_MODE="${mode}" \
        PATH="${stubbin}:${PATH}" PC_SETUP_ROOT="${r}" XDG_RUNTIME_DIR="${r}" \
        PODMAN_STATE="${r}/state" ./scripts/refresh-images check \
        >"${r}/stdout" 2>"${r}/stderr" || code="$?"
    [[ "${code}" == "2" ]] && report ok "check-err-${mode}" \
        || report fail "check-err-${mode}" "exit=${code}"
done

