#!/usr/bin/env bash

set -eu -o pipefail

cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
user_name="$( id --user --name )"

provision_directory() {
    local path="${1}"
    mkdir --parents "${path}"
    chmod 0700 "${path}"
    local owner
    owner="$( stat --format=%U "${path}" )"
    [[ "${owner}" == "${user_name}" ]] || {
        echo "error: ${path} is owned by ${owner}, expected ${user_name}" >&2
        exit 1
    }
    echo "provisioned ${path}"
}

seed_rustup_toolchain() {
    local version="${1}"
    local rustup_home="${cache_home}/cistella/in-container/rustup"
    if RUSTUP_HOME="${rustup_home}" rustup toolchain list 2>/dev/null | grep -q "${version}"; then
        echo "rustup toolchain ${version} already seeded"
        return 0
    fi
    RUSTUP_HOME="${rustup_home}" rustup toolchain install "${version}" \
        --profile minimal --component rustfmt,clippy --no-self-update
}

# Container-owned state, in-container taxonomy: host
# <type>/cistella/in-container maps wholesale to guest <type>, so seat
# state never shadows same-named host state and per-tool dirs land inside
# the tree without new mounts. Known content dirs are pre-created for
# host-side hydration (seat GitHub CLI PAT). Shared host mounts (cargo,
# npm, rustup, gitconfig, ssh, opencode and agentmux state) pre-exist
# outside this tree.
provision_directory "${config_home}/cistella/in-container"
provision_directory "${data_home}/cistella/in-container"
provision_directory "${state_home}/cistella/in-container"
provision_directory "${cache_home}/cistella/in-container"
provision_directory "${config_home}/cistella/in-container/emcd-agents"
provision_directory "${config_home}/cistella/in-container/gh"
provision_directory "${data_home}/cistella/in-container/emcd-agents"
provision_directory "${data_home}/cistella/in-container/uv"
provision_directory "${data_home}/cistella/in-container/opentui"

# Guest-owned rustup tree shared by all seats (cistella/issues/15): one
# mount restores the atomic renames that fail across nested mounts, and
# the host toolchain is neither read nor written from containers. The
# final seat image carries no Rust toolchain of its own, so this tree is
# the seats' only toolchain source: pre-seed the pinned toolchain so
# first use works without a per-seat download and offline seats work at
# all. Version tracks RUST_IMAGE (1.98 family) and the agentmux pinned
# baseline; update together.
provision_directory "${cache_home}/cistella/in-container/rustup"
seed_rustup_toolchain "1.98.0"
