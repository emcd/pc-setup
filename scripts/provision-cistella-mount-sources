#!/usr/bin/env bash

set -eu -o pipefail

cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
state_home="${XDG_STATE_HOME:-${HOME}/.local/state}"
user_name="$( id --user --name )"

provision_directory() {
    local path="${1}"
    mkdir --parents "${path}"
    chmod 0700 "${path}"
    local owner
    owner="$( stat --format=%U "${path}" )"
    [[ "${owner}" == "${user_name}" ]] || {
        echo "error: ${path} is owned by ${owner}, expected ${user_name}" >&2
        exit 1
    }
    echo "provisioned ${path}"
}

# Container-owned state, in-container taxonomy: host
# <type>/cistella/in-container maps wholesale to guest <type>, so seat
# state never shadows same-named host state and per-tool dirs land inside
# the tree without new mounts. Known content dirs are pre-created for
# host-side hydration (seat GitHub CLI PAT). Shared host mounts (cargo,
# npm, rustup, gitconfig, ssh, opencode and agentmux state) pre-exist
# outside this tree.
provision_directory "${config_home}/cistella/in-container"
provision_directory "${data_home}/cistella/in-container"
provision_directory "${state_home}/cistella/in-container"
provision_directory "${cache_home}/cistella/in-container"
provision_directory "${config_home}/cistella/in-container/emcd-agents"
provision_directory "${config_home}/cistella/in-container/gh"
provision_directory "${data_home}/cistella/in-container/emcd-agents"
provision_directory "${data_home}/cistella/in-container/uv"
provision_directory "${data_home}/cistella/in-container/opentui"
