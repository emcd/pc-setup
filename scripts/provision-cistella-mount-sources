#!/usr/bin/env bash

set -eu -o pipefail

cache_home="${XDG_CACHE_HOME:-${HOME}/.cache}"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
cistella_cache="${cache_home}/cistella"
cargo_home="${cistella_cache}/cargo"
gh_auxiliary="${config_home}/cistella/auxiliary"
gh_config="${gh_auxiliary}/gh"
user_name="$( id --user --name )"

provision_directory() {
    local path="${1}"
    mkdir --parents "${path}"
    chmod 0700 "${path}"
    local owner
    owner="$( stat --format=%U "${path}" )"
    [[ "${owner}" == "${user_name}" ]] || {
        echo "error: ${path} is owned by ${owner}, expected ${user_name}" >&2
        exit 1
    }
    echo "provisioned ${path}"
}

provision_directory "${cistella_cache}"
provision_directory "${cargo_home}"
provision_directory "${gh_auxiliary}"
provision_directory "${gh_config}"
