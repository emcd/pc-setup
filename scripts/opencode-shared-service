#!/usr/bin/env bash
#
# Supervise the OpenCode shared service on a container-reachable address.
#
# Why this exists: OpenCode 2's shared background service binds loopback
# and registers itself in the state directory. Containerized clients (the
# Cistella seats) share that state directory, so they read the
# registration and try to connect to it -- but a container's loopback is
# its own, so they can never reach a loopback-bound service. The service
# therefore binds the host's LAN address, which is the address podman
# hands a container as host.containers.internal.
#
# The address is DHCP-assigned, so it is resolved at start and
# re-resolved while running: a lease change would otherwise leave the
# service bound to an address no container can reach.
#
# The port is deliberately not OpenCode's default. A CLI-managed service
# may already hold the default port, and two services must never contend
# for one port: the second one to register displaces the first, which
# shuts itself down.
#
# Environment:
#   OPENCODE_BIN             opencode executable (default: npm prefix)
#   OPENCODE_SHARED_PORT     TCP port to serve on (default: 49400)

set -eu -o pipefail

port="${OPENCODE_SHARED_PORT:-49400}"
opencode_bin="${OPENCODE_BIN:-${HOME}/.local/share/npm-packages/bin/opencode}"

# The host address a container reaches as host.containers.internal: the
# address of the interface carrying the default route.
lan_address() {
    local dev addr
    dev="$(ip -4 route show default | sed -n 's/.* dev \([^ ]*\).*/\1/p' | sed -n 1p)" || return 1
    [[ -n "${dev}" ]] || return 1
    addr="$(ip -4 -o addr show dev "${dev}" | sed -n 's#.* inet \([0-9.]*\)/.*#\1#p' | sed -n 1p)" || return 1
    [[ -n "${addr}" ]] || return 1
    printf '%s' "${addr}"
}

child=""

shutdown() {
    if [[ -n "${child}" ]]; then
        kill -TERM "${child}" 2>/dev/null || true
        wait "${child}" 2>/dev/null || true
    fi
    exit 0
}
trap shutdown TERM INT

while true; do
    addr="$(lan_address || true)"
    if [[ -z "${addr}" ]]; then
        echo "opencode-shared: no default-route address yet; retrying in 10s" >&2
        sleep 10
        continue
    fi

    echo "opencode-shared: serving on ${addr}:${port}" >&2
    "${opencode_bin}" serve --service --hostname "${addr}" --port "${port}" &
    child=$!

    # Watch for a lease change while the service runs.
    while kill -0 "${child}" 2>/dev/null; do
        sleep 30
        current="$(lan_address || true)"
        if [[ -n "${current}" && "${current}" != "${addr}" ]]; then
            echo "opencode-shared: host address changed ${addr} -> ${current}; rebinding" >&2
            kill -TERM "${child}" 2>/dev/null || true
            break
        fi
    done

    wait "${child}" 2>/dev/null || true
    child=""
    sleep 2
done
