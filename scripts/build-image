#!/usr/bin/env bash

set -eu -o pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="opencode"
no_cache=()
extra_labels=()
skip_base=0
skip_parents=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-cache) no_cache+=(--no-cache); shift ;;
        --skip-base) skip_base=1; shift ;;
        --label)
            [[ $# -ge 2 ]] || { echo "error: --label needs KEY=VALUE" >&2; exit 1; }
            extra_labels+=(--label "$2"); shift 2 ;;
        --label=*) extra_labels+=(--label "${1#--label=}"); shift ;;
        base|opencode|codex|muse|opencode-pandoc) target="$1"; shift ;;
        --skip-parents) skip_parents=1; shift ;;
        *)
            echo "error: unknown argument $1" >&2
            exit 1
            ;;
    esac
done

case "$(uname -m)" in
    aarch64|arm64) target_arch=arm64 ;;
    x86_64|amd64) target_arch=amd64 ;;
    *)
        echo "error: unsupported machine architecture $(uname -m)" >&2
        exit 1
        ;;
esac

build_one() {
    local name="$1"
    shift
    local pins_file="${repository_root}/images/cistella/${name}/pins.sh"
    local -a build_args=(--build-arg "TARGETARCH=${target_arch}")
    local line

    build_args+=("$@")
    if [[ "${name}" == "base" ]]; then
        # Self-stamp so refresh automation can tell images built from
        # current pins apart from stale ones. Extra --label args apply
        # to the requested target only, never to this implicit base tag.
        build_args+=(--label "pc-setup.refresh-pins=$(sha256sum "${pins_file}" | cut -d' ' -f1)")
    fi
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "${line}" ]] && continue
        build_args+=(--build-arg "${line}")
    done < "${pins_file}"

    podman build \
        "${build_args[@]}" \
        --file "${repository_root}/images/cistella/${name}/Containerfile" \
        --tag "cistella/${name}:local" \
        "${repository_root}/images/cistella/${name}"
}

if [[ "${target}" == "base" ]]; then
    build_one base "${no_cache[@]}" "${extra_labels[@]}"
    exit 0
fi

# The implicit base rebuild keeps standalone harness builds fresh. Callers
# that manage base themselves (refresh-images builds it explicitly first
# when stale) pass --skip-base so base:local is never rebuilt or retagged
# as a side effect; the harness then builds FROM the selected base tag.
if [[ "${skip_base}" == "0" ]]; then
    build_one base
fi
# shellcheck disable=SC1091
. "${repository_root}/images/cistella/base/pins.sh"
if [[ "${target}" == "opencode-pandoc" && "${skip_parents}" == "0" ]]; then
    # Lane layer sits on the opencode image: build the parent chain
    # first (parents from cache; --no-cache applies to the named image
    # only, matching the harness semantic). Callers that already
    # converged the parents (refresh-images builds them in dependency
    # order) pass --skip-parents so the intermediate build cannot
    # retag opencode:local without its refresh label.
    build_one opencode --build-arg "DEBIAN_IMAGE=${DEBIAN_IMAGE}"
fi
build_one "${target}" "${no_cache[@]}" "${extra_labels[@]}" --build-arg "DEBIAN_IMAGE=${DEBIAN_IMAGE}"
