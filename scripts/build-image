#!/usr/bin/env bash

set -eu -o pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="opencode"
no_cache=()
extra_labels=()
skip_base=0
skip_parents=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-cache) no_cache+=(--no-cache); shift ;;
        --skip-base) skip_base=1; shift ;;
        --label)
            [[ $# -ge 2 ]] || { echo "error: --label needs KEY=VALUE" >&2; exit 1; }
            extra_labels+=(--label "$2"); shift 2 ;;
        --label=*) extra_labels+=(--label "${1#--label=}"); shift ;;
        base|opencode|codex|muse|opencode-pandoc|opencode-litrpg) target="$1"; shift ;;
        --skip-parents) skip_parents=1; shift ;;
        *)
            echo "error: unknown argument $1" >&2
            exit 1
            ;;
    esac
done

case "$(uname -m)" in
    aarch64|arm64) target_arch=arm64 ;;
    x86_64|amd64) target_arch=amd64 ;;
    *)
        echo "error: unsupported machine architecture $(uname -m)" >&2
        exit 1
        ;;
esac

build_one() {
    local name="$1"
    shift
    local pins_file="${repository_root}/images/cistella/${name}/pins.sh"
    local -a build_args=(--build-arg "TARGETARCH=${target_arch}")
    local line

    build_args+=("$@")
    # No self-stamp: the refresh fingerprint covers pins plus the
    # Containerfile closure, so no pins-only label could ever match it.
    # Standalone builds carry no fresh stamp of their own: the final
    # image inherits the base tag's labels (buildah propagates base
    # config, including labels), so a manual build reads as stale until
    # the next refresh converges it with its own label. An explicit
    # --label passed by a caller is the only stamped form.
    while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        [[ -z "${line}" ]] && continue
        build_args+=(--build-arg "${line}")
    done < "${pins_file}"

    podman build \
        "${build_args[@]}" \
        --build-context "mixins=${repository_root}/images/cistella/_mixins" \
        --file "${repository_root}/images/cistella/${name}/Containerfile" \
        --tag "cistella/${name}:local" \
        "${repository_root}/images/cistella/${name}"
}

if [[ "${target}" == "base" ]]; then
    build_one base "${no_cache[@]}" "${extra_labels[@]}"
    exit 0
fi

# Flat finals build FROM the local base tag only: rebuild base from
# cache first, unless the caller manages it. --skip-parents implies
# skipping the base rebuild too (base is the only parent left);
# refresh-images passes both flags once it has converged base itself.
if [[ "${skip_base}" == "0" && "${skip_parents}" == "0" ]]; then
    build_one base
fi
build_one "${target}" "${no_cache[@]}" "${extra_labels[@]}"
