#!/usr/bin/env bash

set -eu -o pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_tag="cistella/opencode:local"
pins_file="${repository_root}/images/cistella/opencode/pins.env"
build_args=()

if [[ "${1:-}" == "--no-cache" ]]; then
    build_args+=(--no-cache)
fi

case "$(uname -m)" in
    aarch64|arm64) target_arch=arm64 ;;
    x86_64|amd64) target_arch=amd64 ;;
    *)
        echo "error: unsupported machine architecture $(uname -m)" >&2
        exit 1
        ;;
esac
build_args+=(--build-arg "TARGETARCH=${target_arch}")

while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "${line}" ]] && continue
    build_args+=(--build-arg "${line}")
done < "${pins_file}"

cd "${repository_root}"
podman build \
    "${build_args[@]}" \
    --file images/cistella/opencode/Containerfile \
    --tag "${image_tag}" \
    images/cistella/opencode
