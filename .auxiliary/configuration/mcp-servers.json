{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host", "mcp"
      ],
      "env": {
        "AGENTMUX_BUNDLE": "${AGENTMUX_BUNDLE}",
        "AGENTMUX_SESSION": "${AGENTMUX_SESSION}",
        "AGENTMUX_CONFIGURATION_DIRECTORY": "${AGENTMUX_CONFIGURATION_DIRECTORY}",
        "AGENTMUX_STATE_DIRECTORY": "${AGENTMUX_STATE_DIRECTORY}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [ "-y", "@upstash/context7-mcp" ]
    },
    "nb": {
      "command": "nb-mcp",
      "args": [
        "--notebook", "pc-setup",
        "--no-commit-signing"
      ]
    },
    "comfyui": {
      "command": "/home/me/.local/bin/comfy-mcp",
      "env": {
        "COMFY_BIN": "/home/me/.local/bin/comfy",
        "COMFYUI_URL": "http://127.0.0.1:8188"
      }
    }
  }
}
