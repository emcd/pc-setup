ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE} AS fetch

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
ARG OPENCODE_VERSION
ARG OPENCODE_SHA256_ARM64
ARG OPENCODE_SHA256_AMD64
RUN set -eu \
    && mkdir --parents /opt/harness \
    && case "${TARGETARCH}" in \
         arm64) oc_plat=linux-arm64; oc_sha="${OPENCODE_SHA256_ARM64}" ;; \
         amd64) oc_plat=linux-x64; oc_sha="${OPENCODE_SHA256_AMD64}" ;; \
         *) echo "error: unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --show-error --silent --output /tmp/opencode.tar.gz \
         "https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/opencode-${oc_plat}.tar.gz" \
    && echo "${oc_sha}  /tmp/opencode.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/opencode.tar.gz --directory /opt/harness \
    && chmod +x /opt/harness/opencode \
    && rm /tmp/opencode.tar.gz

FROM localhost/cistella/base:local
COPY --from=fetch /opt/harness/opencode /usr/local/bin/opencode
