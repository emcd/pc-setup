ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE} AS fetch

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
ARG MUSE_VERSION
ARG MUSE_SHA256_ARM64
ARG MUSE_SHA256_AMD64
RUN set -eu \
    && mkdir --parents /opt/harness \
    && case "${TARGETARCH}" in \
         arm64) muse_file=muse-aarch64-linux; muse_sha="${MUSE_SHA256_ARM64}" ;; \
         amd64) muse_file=muse-x86-linux; muse_sha="${MUSE_SHA256_AMD64}" ;; \
         *) echo "error: unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --show-error --silent --output /tmp/muse.bin \
         "https://lookaside.facebook.com/lookaside/muse/download/?channel=muse&version=${MUSE_VERSION}&file=${muse_file}" \
    && echo "${muse_sha}  /tmp/muse.bin" | sha256sum --check --strict \
    && install --mode=0755 /tmp/muse.bin /opt/harness/muse \
    && rm /tmp/muse.bin

FROM localhost/cistella/base:local
COPY --from=fetch /opt/harness/muse /usr/local/bin/muse
