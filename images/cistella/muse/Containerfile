# Harness lane: the shared base plus the verified Muse binary.
FROM localhost/cistella/base:local

ARG TARGETARCH
ARG MUSE_VERSION
ARG MUSE_SHA256_ARM64
ARG MUSE_SHA256_AMD64
# Explicit declared files only: unlisted mixin-dir files are neither
# copied nor fingerprinted, so they cannot affect the image silently.
COPY --from=mixins harness-muse/install.sh /tmp/mixins/harness-muse/install.sh
RUN sh /tmp/mixins/harness-muse/install.sh \
    && rm -rf /tmp/mixins
