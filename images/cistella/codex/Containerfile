# Harness lane: the shared base plus the verified Codex binary.
FROM localhost/cistella/base:local

ARG TARGETARCH
ARG CODEX_VERSION
ARG CODEX_SHA256_ARM64
ARG CODEX_SHA256_AMD64
# Explicit declared files only: unlisted mixin-dir files are neither
# copied nor fingerprinted, so they cannot affect the image silently.
COPY --from=mixins harness-codex/install.sh /tmp/mixins/harness-codex/install.sh
RUN sh /tmp/mixins/harness-codex/install.sh \
    && rm -rf /tmp/mixins
