[Unit]
Description=OpenCode shared service for host and containerized clients
Documentation=https://opencode.ai/v2/docs/cli/
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/opencode-shared-service
Restart=always
RestartSec=3
# The server launches the project's MCP servers as child processes, so it
# needs the same PATH the interactive shell has: mise shims for node, npx
# and python3, cargo for agentmux and nb-mcp, and the npm prefix for
# opencode, gh and the other harness CLIs.
Environment=PATH=%h/.local/share/mise/shims:%h/.cargo/bin:%h/.local/bin:%h/.local/share/npm-packages/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
